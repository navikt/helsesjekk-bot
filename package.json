{
    "name": "helsesjekk",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "packageManager": "yarn@4.18.0",
    "dependenciesMeta": {
        "@prisma/engines": {
            "built": true
        }
    },
    "engines": {
        "node": "24"
    },
    "resolutions": {
        "deepmerge-ts@npm:7.1.5": "npm:7.1.6",
        "mysql2@npm:3.15.3": "npm:3.24.4"
    },
    "scripts": {
        "dev": "next dev | pino-pretty --messageKey=message",
        "dev:db": "docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 -it postgres:16",
        "build": "next build",
        "start": "next start",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest",
        "start:migrate": "yarn prisma:migrate && yarn start",
        "prisma:generate": "prisma generate && yarn prettier --write src/db/generated/**/*.{ts,mjs}",
        "prisma:migrate": "NODE_OPTIONS='-r next-logger' prisma migrate deploy",
        "prisma:migrate-dev": "prisma migrate dev",
        "prisma:seed": "node --env-file=.env --env-file=.env.development --import tsx/esm seed/seed.ts | pino-pretty --messageKey=message",
        "postinstall": "command -v husky && husky || true"
    },
    "dependencies": {
        "@navikt/aksel-icons": "^8.20.1",
        "@navikt/ds-css": "^8.20.1",
        "@navikt/ds-react": "^8.20.1",
        "@navikt/ds-tailwind": "^8.20.1",
        "@navikt/next-logger": "^5.0.1",
        "@navikt/oasis": "^4.2.2",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "7.10.1",
        "@slack/bolt": "^4.7.3",
        "@slack/logger": "^4.0.1",
        "@slack/types": "^2.22.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.9",
        "next": "^16.4.3",
        "next-logger": "^5.0.2",
        "nextleton": "^0.6.1",
        "node-cron": "^4.6.0",
        "nuqs": "^2.10.2",
        "pino": "^10.4.0",
        "postcss": "^8.5.31",
        "prisma": "7.10.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-is": "^19.3.1",
        "recharts": "3.1.2",
        "remeda": "^2.54.1",
        "sharp": "^0.35.5",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@navikt/tsm-oxfmt": "^0.0.11",
        "@navikt/tsm-oxlint": "^0.0.7",
        "@navikt/tsm-prettier": "^2.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24.19.2",
        "@types/node-cron": "^3.0.11",
        "@types/react": "19.3.0",
        "@types/react-is": "^19",
        "@vercel/nft": "^1.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "pino-pretty": "^13.2.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "prettier": "@navikt/tsm-prettier"
}
