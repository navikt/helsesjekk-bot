{
    "name": "helsesjekk",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "packageManager": "yarn@4.18.0",
    "engines": {
        "node": "24"
    },
    "scripts": {
        "dev": "next dev | pino-pretty --messageKey=message",
        "dev:db": "docker compose up -d",
        "build": "next build",
        "start": "next start",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "node --env-file=.env --env-file=.env.development --import tsx/esm seed/seed.ts | pino-pretty --messageKey=message",
        "postinstall": "command -v husky && husky || true"
    },
    "dependencies": {
        "@navikt/aksel-icons": "^8.20.1",
        "@navikt/ds-css": "^8.20.1",
        "@navikt/ds-react": "^8.20.1",
        "@navikt/ds-tailwind": "^8.20.1",
        "@navikt/next-logger": "^5.0.1",
        "@navikt/oasis": "^4.2.2",
        "@slack/bolt": "^4.7.3",
        "@slack/logger": "^4.0.1",
        "@slack/types": "^2.22.0",
        "@tanstack/charts": "^1.1.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.9",
        "drizzle-orm": "1.0.0-rc.5",
        "next": "^16.4.3",
        "next-logger": "^5.0.2",
        "nextleton": "^0.6.1",
        "node-cron": "^4.6.0",
        "nuqs": "^2.10.2",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "postcss": "^8.5.32",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-is": "^19.3.1",
        "remeda": "^2.54.1",
        "sharp": "^0.35.5",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@navikt/tsm-oxfmt": "^0.0.11",
        "@navikt/tsm-oxlint": "^0.0.7",
        "@navikt/tsm-prettier": "^2.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testcontainers/postgresql": "^12.2.1",
        "@types/node": "^24.19.2",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.23.1",
        "@types/react": "19.3.0",
        "@types/react-is": "^19.3.0",
        "@vercel/nft": "^1.11.0",
        "drizzle-kit": "1.0.0-rc.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "pino-pretty": "^13.2.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "prettier": "@navikt/tsm-prettier"
